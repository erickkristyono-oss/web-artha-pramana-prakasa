# Server
PORT=3000
NODE_ENV=development

# PostgreSQL — isi DATABASE_URL (production, mis. Neon/Supabase), ATAU variabel PG* di bawah (lokal)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=artha_pramana_prakasa

# Sesi login (hari)
SESSION_TTL_DAYS=7

# Payment gateway: "dummy" untuk saat ini (nanti: midtrans / xendit)
PAYMENT_PROVIDER=dummy
